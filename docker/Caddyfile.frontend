# Frontend (Vue app + Starlight docs under /docs/) for https://fundsflow.fun.
# TLS, HTTP/2 and HTTP/3 are handled by Traefik (Dokploy) in front of this container,
# so Caddy only speaks plain HTTP/1.1 on :80.
#
# Build-time values come from /etc/caddy/csp.env (written by docker/frontend, loaded with --envfile):
#   API_ORIGIN          origin of VITE_API_URL, the only cross-origin host the app talks to
#   APP_SCRIPT_HASHES   hashes of the inline scripts in the app's index.html (docker/csp-hashes.mjs)
#   DOCS_SCRIPT_HASHES  hashes of Starlight's inline scripts (docker/csp-hashes.mjs)
{
	auto_https off
	admin off
	servers {
		trusted_proxies static private_ranges
		client_ip_headers X-Forwarded-For X-Real-IP
	}
}

# Headers shared by the app and the docs.
# - No X-Frame-Options: the app runs as a Telegram Mini App inside web.telegram.org; framing is governed by CSP frame-ancestors.
# - COOP same-origin: nothing needs a cross-origin opener (OAuth is a full-page redirect, t.me links open without one).
# - CORP same-origin: nobody embeds these files cross-origin; link-preview bots fetch og.png server-side, which CORP doesn't affect.
# - HSTS without preload: preload is a hard-to-undo commitment for every subdomain.
(common_headers) {
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Resource-Policy same-origin
		Permissions-Policy "accelerometer=(), browsing-topics=(), camera=(), geolocation=(), gyroscope=(), hid=(), magnetometer=(), microphone=(), midi=(), payment=(), serial=(), usb=()"
	}
}

# App CSP: inline scripts only by hash (the theme snippet in index.html), no inline styles at all
# (Vue sets styles through the CSSOM, which CSP allows).
# telegram.org serves the Mini App SDK; blob: covers attachment previews and the print iframe.
(app_headers) {
	import common_headers
	header Content-Security-Policy "default-src 'self'; script-src 'self' https://telegram.org {$APP_SCRIPT_HASHES}; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' {$API_ORIGIN}; frame-src 'self' blob:; base-uri 'none'; form-action 'none'; frame-ancestors 'self' https://web.telegram.org https://*.telegram.org; object-src 'none'; upgrade-insecure-requests"
}

# Docs CSP: Starlight's inline scripts are allowed by hash; Pagefind search runs WebAssembly ('wasm-unsafe-eval').
# style-src keeps 'unsafe-inline' because the code blocks use ~1.5k style="" attributes.
(docs_headers) {
	import common_headers
	header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' {$DOCS_SCRIPT_HASHES}; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'; object-src 'none'; upgrade-insecure-requests"
}

# .br/.gz and .etag sidecars are written at build time (docker/precompress.mjs);
# files without a .br/.gz are compressed on the fly by `encode`.
(static) {
	file_server {
		precompressed br gzip
		etag_file_extensions .etag
		hide *.etag
	}
}

# Cache-Control for each kind of file. Hashed files are immutable; HTML and files that other files
# reference by a fixed name are revalidated with the content-hash ETag (a 304 costs one round trip).
(cache_rules) {
	@images path_regexp \.(png|jpg|jpeg|gif|ico|svg|webp|avif|woff|woff2|ttf)$
	@meta path_regexp \.(txt|xml|webmanifest)$
	@scripts path_regexp \.(js|css)$
	route {
		header Cache-Control "no-cache"
		header @images Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
		header @meta Cache-Control "public, max-age=3600"
		header @scripts Cache-Control "public, max-age=3600, stale-while-revalidate=86400"
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		header /docs/_astro/* Cache-Control "public, max-age=31536000, immutable"
		# Pagefind chunks carry a content hash in their names; the entry files (pagefind.js,
		# pagefind-entry.json, wasm.*.pagefind) don't, so they stay no-cache.
		header /docs/pagefind/fragment/* Cache-Control "public, max-age=31536000, immutable"
		header /docs/pagefind/index/* Cache-Control "public, max-age=31536000, immutable"
		header /docs/pagefind/*.pf_meta Cache-Control "public, max-age=31536000, immutable"
		header /docs/pagefind/pagefind.js Cache-Control "no-cache"
		header /docs/pagefind/pagefind-* Cache-Control "no-cache"
	}
}

:80 {
	root * /srv

	encode {
		zstd
		gzip
		minimum_length 256
	}

	# Pagefind index files are already gzipped binaries: serve them as opaque bytes.
	@pagefind_data path_regexp \.(pagefind|pf_meta|pf_index|pf_fragment)$
	header @pagefind_data Content-Type application/octet-stream

	# Relative Location.
	redir /docs /docs/ 301

	handle /docs/* {
		import docs_headers
		import cache_rules
		try_files {path} {path}/index.html {path}.html =404
		import static
	}

	# Hashed build output: a missing chunk must be a real 404, never index.html,
	# so the vite:preloadError handler in main.js can reload the page after a deploy.
	handle /assets/* {
		import app_headers
		import cache_rules
		try_files {path} =404
		import static
	}

	# Other files with an extension (favicon, og.png, robots.txt, ...) are real files or 404.
	@app_file path_regexp \.[a-zA-Z0-9]+$
	handle @app_file {
		import app_headers
		import cache_rules
		try_files {path} =404
		import static
	}

	# SPA routes fall back to index.html.
	handle {
		import app_headers
		header Cache-Control "no-cache"
		try_files {path} /index.html
		import static
	}

	# Errors are never cached, so a deploy that adds the file fixes it right away.
	handle_errors 404 {
		header -Server
		header Cache-Control "no-store"
		handle /docs/* {
			import docs_headers
			rewrite * /docs/404.html
			import static
		}
		handle {
			import app_headers
			respond "404 Not Found"
		}
	}
}
