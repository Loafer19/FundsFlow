FROM oven/bun:1-alpine

WORKDIR /app

COPY mcp/package.json mcp/bun.lock ./
RUN bun install --frozen-lockfile --production

COPY mcp/index.ts mcp/oauth.ts mcp/tsconfig.json ./

ENV HOST=0.0.0.0
ENV PORT=8787
ENV ALLOWED_HOSTS=mcp.fundsflow.fun,127.0.0.1,localhost

EXPOSE 8787

CMD ["bun", "run", "index.ts"]
