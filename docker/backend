FROM dunglas/frankenphp:php8.4-alpine

RUN apk add icu-dev libzip-dev unzip poppler-utils && \
    install-php-extensions bcmath intl pcntl pdo_mysql opcache redis zip

RUN echo "memory_limit = 4G" >> /usr/local/etc/php/conf.d/memory-limit.ini && \
    printf "upload_max_filesize = 25M\npost_max_size = 32M\n" > /usr/local/etc/php/conf.d/uploads.ini



WORKDIR /app

COPY backend /app
COPY docker/Caddyfile /etc/frankenphp/Caddyfile

COPY --from=composer:latest /usr/bin/composer /usr/local/bin/composer

# composer's post-autoload-dump runs `php artisan filament:upgrade`, which publishes the
# Filament/Livewire assets into public/{js,css,fonts}/filament for /admin (not committed).
RUN composer install --no-dev --optimize-autoloader --no-interaction --no-progress --no-suggest --prefer-dist && \
    composer dump-autoload --optimize

COPY docker/backend-entrypoint.sh /usr/local/bin/backend-entrypoint
RUN chmod +x /usr/local/bin/backend-entrypoint

EXPOSE 80

# Runs `php artisan migrate --force` (opt out with AUTO_MIGRATE=false), then execs the base
# image's docker-php-entrypoint. Setting ENTRYPOINT drops the inherited CMD, so restate it.
ENTRYPOINT ["backend-entrypoint"]
CMD ["--config", "/etc/frankenphp/Caddyfile", "--adapter", "caddyfile"]
