FUNDSFLOW_API_URL=https://api.fundsflow.fun/api
# Optional fallback if the MCP client does not send Authorization.
# Without MCP_KEY it only serves direct loopback clients (no proxy).
FUNDSFLOW_TOKEN=
# Shared key required to use FUNDSFLOW_TOKEN remotely (header X-FundsFlow-MCP-Key or ?key=)
MCP_KEY=
HOST=127.0.0.1
PORT=8787
ALLOWED_HOSTS=127.0.0.1,localhost,mcp.fundsflow.fun
# Extra OAuth redirect URIs (comma-separated, exact match incl. path and trailing slash).
# Always allowed: http loopback 127.0.0.1 / localhost / [::1] on any port (RFC 8252), plus built-ins:
# https://claude.ai/api/mcp/auth_callback, https://claude.com/api/mcp/auth_callback,
# https://chatgpt.com/connector_platform_oauth_redirect, https://chatgpt.com/connector/oauth/<callback_id>,
# https://www.cursor.com/agents/mcp/oauth/callback, cursor://anysphere.cursor-mcp/oauth/callback,
# https://vscode.dev/redirect, https://insiders.vscode.dev/redirect,
# https://grok.com/connectors-oauth-exchange-code/ (with or without trailing slash)
# Example: OAUTH_REDIRECT_ALLOWLIST=https://app.example.com/oauth/callback,myapp://oauth/callback
OAUTH_REDIRECT_ALLOWLIST=
