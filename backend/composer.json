{
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "require": {
        "php": "^8.4",
        "filament/filament": "^5.10",
        "laravel/framework": "^12.17",
        "laravel/octane": "^2.9",
        "laravel/sanctum": "^4.1",
        "laravel/socialite": "^5.21",
        "openspout/openspout": "^4.32 || ^5.12"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "laravel/pint": "^1.22"
    },
    "scripts": {
        "pint": "./vendor/bin/pint -v",
        "post-autoload-dump": [
            "@php artisan filament:upgrade"
        ]
    },
    "type": "project"
}
