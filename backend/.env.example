APP_NAME="FundsFlow"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://api.site.com

FRONTEND_URL=http://localhost:5173

LOG_CHANNEL=daily

CACHE_STORE=redis
CACHE_PREFIX=

REDIS_PREFIX=funds:
REDIS_CLIENT=phpredis
REDIS_PASSWORD=

# Sessions are used only by the /admin panel (the API stays token-only). Defaults to redis when CACHE_STORE=redis.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_DOMAIN=api.site.com
SESSION_SECURE_COOKIE=true

DB_CONNECTION=mysql
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

CORS_ALLOWED_ORIGINS="https://api.site.com,http://localhost:5173"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.site.com/api/auth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://api.site.com/api/auth/github/callback

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Support requests: admins (is_admin) with a linked Telegram get alerts; add more chat ids (comma-separated), e.g. a group.
SUPPORT_ADMIN_TELEGRAM_CHAT_ID=
# System alerts (failed queue jobs, worker down/recovered), comma-separated. Empty: admins with a linked Telegram.
TELEGRAM_ADMIN_CHAT_ID=
# SUPPORT_MAX_PER_HOUR=5

GOTENBERG_URL=http://127.0.0.1:3000
# Report PDFs: the frontend URL Gotenberg's Chromium opens to print ReportDocument.vue
# (<url>/?print=report#t=<one-time token>). It must be reachable from the Gotenberg container,
# and the page then calls VITE_API_URL from there. Empty = server HTML report (no charts/theme).
# REPORT_RENDER_URL=https://fundsflow.fun
REPORT_RENDER_URL=

XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_VISION_MODEL=grok-4
XAI_TEXT_MODEL=grok-4
XAI_STT_MODEL=grok-voice-transcribe-2.0
AI_RECEIPT_DAILY_LIMIT=10

# Telegram bot tuning (defaults shown; uncomment to override)
# TELEGRAM_SESSION_TTL_MINUTES=20
# TELEGRAM_PENDING_TTL_MINUTES=15
# TELEGRAM_ALBUM_DEBOUNCE_SECONDS=3
# TELEGRAM_ALBUM_COLLECT_TTL_SECONDS=60
# TELEGRAM_AGENT_MAX_ROUNDS=6
# TELEGRAM_LOW_QUOTA_THRESHOLD=2
# TELEGRAM_STREAM_DRAFTS=true
# AGENT_SHARED_HISTORY_TTL_MINUTES=60
# AGENT_SHARED_HISTORY_MAX=40
# TELEGRAM_XAI_CHAT_TIMEOUT=60
# TELEGRAM_XAI_VISION_TIMEOUT=45
# TELEGRAM_XAI_STT_TIMEOUT=60
# GOTENBERG_SCREENSHOT_TIMEOUT=60
# GOTENBERG_PDF_TIMEOUT=120
# GOTENBERG_CONNECT_TIMEOUT=10

# Personal Monobank API. The webhook URL is {APP_URL}/api/webhooks/monobank/{uuid},
# so APP_URL must be the public API origin.
# MONOBANK_BASE_URL=https://api.monobank.ua
# MONOBANK_REQUEST_INTERVAL=60

# Queue. Laravel defaults to database. Without a worker, Telegram, Monobank, import commits
# and widget sync run after the HTTP response. With a worker (same image, command
# `php artisan queue:work --tries=3 --max-time=3600`, see docs/self-hosting/queue-worker),
# set both on the web service and the worker:
# QUEUE_CONNECTION=database
# TELEGRAM_WIDGETS_QUEUE=true
# Worker heartbeat alerts follow TELEGRAM_WIDGETS_QUEUE; override with QUEUE_MONITOR=true|false.
# QUEUE_HEARTBEAT_STALE_MINUTES=5
# QUEUE_DOWN_REPEAT_MINUTES=60
# QUEUE_FAILURE_ALERT_THROTTLE_MINUTES=10

