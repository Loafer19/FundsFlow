---
import analyticsDark from '../assets/app-analytics-dark.webp'
import analyticsLight from '../assets/app-analytics-light.webp'
import budgetsDark from '../assets/app-budgets-dark.webp'
import budgetsLight from '../assets/app-budgets-light.webp'
import calendarDark from '../assets/app-calendar-dark.webp'
import calendarLight from '../assets/app-calendar-light.webp'
import { docs } from '../config'
import ThemedShot from './ThemedShot.astro'

const sideSizes = '(min-width: 1152px) 542px, (min-width: 1024px) calc(50vw - 2.5rem), calc(100vw - 2rem)'
const shots = [
    {
        light: budgetsLight,
        dark: budgetsDark,
        caption: 'Budgets: savings goals and spending limits with pace and days left',
        alt: 'FundsFlow Budgets tab: totals for savings goals, Emergency fund at 54% and Japan trip at 30% with monthly amounts needed, and spending limits for Groceries at 92% (near limit) and Transport at 37%',
    },
    {
        light: calendarLight,
        dark: calendarDark,
        caption: 'Calendar: every day of the month, today’s transactions, and upcoming payments',
        alt: 'FundsFlow Calendar tab for October 2026: income, expenses, and net cards, a month grid with daily amounts and planned payments, today’s transactions, and upcoming iCloud, gym, rent, and Netflix payments',
    },
]

const features = [
    {
        icon: '🧾',
        title: 'Receipt photos & albums',
        text: 'Send a photo without an amount and AI vision drafts the total, date, note, and tags for you to confirm. Albums become one transaction or several.',
        href: docs('telegram/receipts/'),
    },
    {
        icon: '🎤',
        title: 'Voice messages',
        text: 'Say “minus three hundred fifty groceries” in your own language. The transcript is handled just like a typed message.',
        href: docs('telegram/voice/'),
    },
    {
        icon: '✨',
        title: 'AI assistant',
        text: 'Ask questions, draw charts, and stage changes in plain language — in the web app and in Telegram. Nothing is saved until you confirm.',
        href: docs('web/assistant/'),
    },
    {
        icon: '💰',
        title: 'Budgets',
        text: 'Weekly, monthly, or yearly limits for one or more tags, with pause/resume, period history, and Telegram alerts at 80% and 100%.',
        href: docs('web/budgets/'),
    },
    {
        icon: '🔁',
        title: 'Recurring payments',
        text: 'Rent, salary, and subscriptions are added automatically — daily, weekly, monthly, or yearly — and show up in the calendar forecast.',
        href: docs('web/recurring/'),
    },
    {
        icon: '📊',
        title: 'Analytics & charts',
        text: 'Analytics, Calendar, Budgets, Tags, Flow, Trend, and List tabs, with a week / month / year period bar and previous-period comparison.',
        href: docs('web/tabs/'),
    },
    {
        icon: '📄',
        title: 'PDF reports',
        text: 'Pick the tabs you need and print the report, or have it rendered as a PDF and sent to your Telegram chat.',
        href: docs('web/reports/'),
    },
    {
        icon: '📱',
        title: 'Telegram Mini App',
        text: 'The full web app inside Telegram, signed in automatically from your linked chat, with native back and main buttons.',
        href: docs('mini-app/'),
    },
]
---

<section id="features" class="py-20" aria-labelledby="features-title">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <p class="text-brand text-sm font-semibold tracking-wide uppercase">Features</p>
        <h2 id="features-title" class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">Built for everyday tracking</h2>
        <p class="mt-4 max-w-2xl text-base-content/80">
            Hierarchical tags with emojis, attachments on every transaction, and the formats and timezone you prefer.
        </p>
        <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
            {
                features.map((f) => (
                    <li class="group relative rounded-box border border-base-300 bg-base-100 p-6 transition-colors hover:border-primary">
                        <div class="text-3xl" aria-hidden="true">
                            {f.icon}
                        </div>
                        <h3 class="mt-3 text-lg font-semibold">
                            <a href={f.href} class="after:absolute after:inset-0 focus-visible:outline-none">
                                {f.title}
                            </a>
                        </h3>
                        <p class="mt-2 text-sm text-base-content/80">{f.text}</p>
                    </li>
                ))
            }
        </ul>

        <div class="mt-16 grid gap-6 lg:grid-cols-2">
            <figure class="lg:col-span-2">
                <div class="overflow-hidden rounded-box border border-base-300 bg-base-100 shadow-lg">
                    <ThemedShot
                        light={analyticsLight}
                        dark={analyticsDark}
                        widths={[640, 1104, 1600, 2208]}
                        sizes="(min-width: 1152px) 1104px, calc(100vw - 2rem)"
                        alt="FundsFlow web app, Analytics tab for October 2026: income, expenses, net, savings rate, transaction count, and average daily expense compared with the previous month, an end-of-month forecast, insights, top spending tags, and largest expenses"
                    />
                </div>
                <figcaption class="mt-3 text-sm text-base-content/60">
                    Analytics: the month at a glance, compared with the previous one (demo data)
                </figcaption>
            </figure>
            {
                shots.map((s) => (
                    <figure>
                        <div class="overflow-hidden rounded-box border border-base-300 bg-base-100 shadow-lg">
                            <ThemedShot light={s.light} dark={s.dark} widths={[480, 800, 1084]} sizes={sideSizes} alt={s.alt} />
                        </div>
                        <figcaption class="mt-3 text-sm text-base-content/60">{s.caption}</figcaption>
                    </figure>
                ))
            }
        </div>
    </div>
</section>
