---
import { Image } from 'astro:assets'
import logo from '../assets/logo.png'
import { APP_URL, BASE, DOCS_URL } from '../config'

const links = [
    { href: '#ways', label: 'How it works' },
    { href: '#features', label: 'Features' },
    { href: '#assistant', label: 'AI assistant' },
    { href: '#mcp', label: 'MCP' },
    { href: '#faq', label: 'FAQ' },
]
---

<header class="sticky top-0 z-40 border-b border-base-300 bg-base-100/90 backdrop-blur">
    <nav class="mx-auto flex h-16 max-w-6xl items-center gap-4 px-4 sm:px-6" aria-label="Main">
        <a href={BASE} class="flex items-center gap-2 text-lg font-bold" aria-label="FundsFlow home">
            <Image src={logo} alt="" width={36} height={36} layout="fixed" loading="eager" class="size-9" />
            <span>FundsFlow</span>
        </a>
        <ul class="ml-6 hidden items-center gap-1 lg:flex">
            {
                links.map((l) => (
                    <li>
                        <a href={l.href} class="btn btn-ghost btn-sm font-medium">
                            {l.label}
                        </a>
                    </li>
                ))
            }
        </ul>
        <div class="ml-auto flex items-center gap-2">
            <a href={DOCS_URL} class="btn btn-ghost btn-sm hidden sm:inline-flex">Docs</a>
            <a href={APP_URL} class="btn btn-primary btn-sm">Open app</a>
        </div>
    </nav>
</header>
