---
import { MCP_ENDPOINT, docs } from '../config'

const clients = ['Claude', 'Claude Code', 'ChatGPT', 'Cursor', 'VS Code', 'Grok', 'Grok CLI']
const cursorConfig = `{
  "mcpServers": {
    "fundsflow": {
      "url": "${MCP_ENDPOINT}"
    }
  }
}`
---

<section id="mcp" class="py-20" aria-labelledby="mcp-title">
    <div class="mx-auto grid max-w-6xl gap-12 px-4 sm:px-6 lg:grid-cols-2">
        <div class="min-w-0">
            <p class="text-brand text-sm font-semibold tracking-wide uppercase">MCP server</p>
            <h2 id="mcp-title" class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">Bring your own AI</h2>
            <p class="mt-4 text-base-content/80">
                FundsFlow has a remote Model Context Protocol server. Connect the assistant you already use and ask “how much
                did I spend on groceries last month?” or “create a monthly budget of 300 for coffee”.
            </p>
            <ul class="mt-6 flex flex-wrap gap-2" aria-label="Supported clients">
                {clients.map((c) => <li class="badge badge-lg badge-neutral">{c}</li>)}
                <li class="badge badge-lg badge-outline">any streamable HTTP client</li>
            </ul>
            <ul class="mt-8 space-y-3 text-base-content/80">
                <li><strong class="text-base-content">30 tools</strong> — tags, transactions (bulk up to 50), attachments, budgets, recurring rules, preferences, and a full JSON export.</li>
                <li><strong class="text-base-content">OAuth 2.1 with PKCE</strong> or a personal bearer token from Settings → Accounts → MCP.</li>
                <li><strong class="text-base-content">Traceable</strong> — transactions created over MCP are marked with the MCP source in the web app.</li>
            </ul>
            <a href={docs('ai/connect-clients/')} class="btn btn-primary mt-8">Set up your client</a>
        </div>

        <div class="min-w-0 space-y-5">
            <div class="rounded-box border border-base-300 bg-base-200 p-5">
                <div class="text-sm font-semibold">Endpoint</div>
                <p class="mt-2 overflow-x-auto rounded-field bg-base-100 px-4 py-3 font-mono text-sm">
                    <code class="select-all">{MCP_ENDPOINT}</code>
                </p>
                <p class="mt-2 text-xs text-base-content/70">Click to select, then copy. Transport: streamable HTTP.</p>
            </div>
            <div class="rounded-box border border-base-300 bg-neutral p-5 text-neutral-content">
                <div class="text-sm font-semibold">Cursor · <span class="font-mono font-normal opacity-80">~/.cursor/mcp.json</span></div>
                <pre class="mt-3 overflow-x-auto font-mono text-sm leading-relaxed"><code>{cursorConfig}</code></pre>
            </div>
            <div class="rounded-box border border-base-300 bg-neutral p-5 text-neutral-content">
                <div class="text-sm font-semibold">Claude Code</div>
                <pre class="mt-3 font-mono text-sm leading-relaxed break-all whitespace-pre-wrap"><code>claude mcp add --transport http fundsflow {MCP_ENDPOINT}</code></pre>
            </div>
        </div>
    </div>
</section>
