---
import { docs } from '../config'

const points = [
    ['Streams answers', 'Watch the reply being written, with steps like “Reading tags” or “Building chart” while it looks things up.'],
    ['Draws charts', 'Spending by tag, income vs expenses, and balance trend — in the web app with the same chart components as the tabs, in Telegram as PNG images.'],
    ['Asks before it changes anything', 'Adding, editing, or deleting a transaction, creating a budget or tags: every change is a card with Confirm and Cancel.'],
    ['Always one keystroke away', 'Press / or Ctrl+K (⌘K) in the web app to open the panel. Write in any language.'],
]
---

<section id="assistant" class="bg-base-200 py-20" aria-labelledby="assistant-title">
    <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 sm:px-6 lg:grid-cols-2">
        <div class="min-w-0">
            <p class="text-brand text-sm font-semibold tracking-wide uppercase">AI assistant</p>
            <h2 id="assistant-title" class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">
                Ask “how much did I spend this month?”
            </h2>
            <p class="mt-4 text-base-content/80">
                The same finance assistant lives in the web app's ✨ Assistant panel and in the Telegram bot. It uses real
                numbers from your account and never makes up amounts.
            </p>
            <ul class="mt-8 space-y-5">
                {
                    points.map(([t, d]) => (
                        <li class="flex gap-3">
                            <span class="mt-1 text-success" aria-hidden="true">✓</span>
                            <div>
                                <h3 class="font-semibold">{t}</h3>
                                <p class="text-base-content/80">{d}</p>
                            </div>
                        </li>
                    ))
                }
            </ul>
            <p class="mt-8 text-sm text-base-content/70">
                AI features share a daily limit of <strong>AI assists</strong> (5 per day by default), reset at midnight in
                your timezone. Quick add, the + button, and all tabs keep working without AI.{' '}
                <a href={docs('web/assistant/')} class="link">More about the assistant</a>
            </p>
        </div>

        <!-- screenshot: web AI assistant drawer with a donut chart and a confirm card (replace this mock with a real demo screenshot) -->
        <div class="mx-auto w-full max-w-md" role="img" aria-label="Illustration: the assistant panel answering with a spending-by-tag donut chart and a confirm card for adding a transaction">
            <div class="rounded-3xl border border-base-300 bg-base-100 shadow-xl" aria-hidden="true">
                <div class="flex items-center justify-between border-b border-base-300 px-5 py-3">
                    <span class="font-semibold">✨ Assistant</span>
                    <span class="badge badge-sm border-base-300 bg-base-200 text-base-content">3/5 · resets 00:00</span>
                </div>
                <div class="space-y-4 p-5 text-sm">
                    <div class="ml-auto w-fit max-w-[85%] rounded-2xl rounded-br-sm bg-primary px-3.5 py-2 text-primary-content">
                        Chart of spending by tag this month
                    </div>
                    <div class="rounded-2xl border border-base-300 p-4">
                        <div class="text-xs font-semibold text-base-content/70">Spending by tag · this month</div>
                        <div class="mt-3 flex items-center gap-5">
                            <div class="relative size-24 shrink-0 rounded-full bg-[conic-gradient(var(--color-amber-400)_0_42%,var(--color-sky-400)_42%_68%,var(--color-emerald-400)_68%_86%,var(--color-rose-400)_86%_100%)]">
                                <div class="absolute inset-4 rounded-full bg-base-100"></div>
                            </div>
                            <ul class="space-y-1.5 text-xs">
                                <li class="flex items-center gap-2"><span class="size-2.5 rounded-full bg-amber-400"></span>🛒 Groceries</li>
                                <li class="flex items-center gap-2"><span class="size-2.5 rounded-full bg-sky-400"></span>🏠 Home</li>
                                <li class="flex items-center gap-2"><span class="size-2.5 rounded-full bg-emerald-400"></span>🚕 Transport</li>
                                <li class="flex items-center gap-2"><span class="size-2.5 rounded-full bg-rose-400"></span>☕ Coffee</li>
                            </ul>
                        </div>
                    </div>
                    <div class="ml-auto w-fit max-w-[85%] rounded-2xl rounded-br-sm bg-primary px-3.5 py-2 text-primary-content">
                        Add -350 groceries today
                    </div>
                    <div class="rounded-2xl border-2 border-dashed border-primary p-4">
                        <div class="text-xs font-semibold text-base-content/70">Add transaction</div>
                        <div class="mt-1 font-mono">-350.00 · today · 🛒 Groceries</div>
                        <div class="mt-3 flex gap-2">
                            <span class="btn btn-primary btn-sm">Confirm</span>
                            <span class="btn btn-ghost btn-sm">Cancel</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
